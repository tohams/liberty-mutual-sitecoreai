{
  "name": "liberty-mutual-public-site",
  "version": "1.0.0",
  "private": true,
  "config": {
    "appName": "liberty-mutual-public-site",
    "graphQLEndpointPath": "/sitecore/api/graph/edge",
    "language": "en",
    "template": "nextjs"
  },
  "author": {
    "name": "Sitecore Corporation",
    "url": "https://doc.sitecore.com/xmc/en/developers/content-sdk/index.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitecore/content-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/sitecore/content-sdk/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@sitecore-content-sdk/analytics-core": "^2.1.2",
    "@sitecore-content-sdk/events": "^2.1.2",
    "@sitecore-content-sdk/nextjs": "^2.3.0",
    "@sitecore-content-sdk/personalize": "^2.1.0",
    "next": "^16.3.0",
    "next-intl": "^4.9.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rsc-env": "0.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@sitecore-content-sdk/cli": "^2.2.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.10.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "cross-env": "^10.0.0",
    "eslint": "^9.33.0",
    "eslint-config-next": "16.2.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "postcss": ">=8.5.10",
    "picomatch": "4.0.4",
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "brace-expansion@^5.0.0": "5.0.9",
    "lodash-es": "4.18.1",
    "flatted": "3.4.2",
    "esbuild": ">=0.28.1"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production npm-run-all --serial sitecore-tools:generate-map sitecore-tools:build next:build",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit --incremental false",
    "next:build": "next build",
    "next:dev": "next dev",
    "next:start": "next start",
    "sitecore-tools:generate-map": "sitecore-tools project component generate-map",
    "sitecore-tools:generate-map:watch": "sitecore-tools project component generate-map --watch",
    "sitecore-tools:build": "sitecore-tools project build",
    "dev": "cross-env NODE_ENV=development npm-run-all --serial sitecore-tools:generate-map sitecore-tools:build --parallel next:dev sitecore-tools:generate-map:watch",
    "start": "next start",
    "next:dev:https": "next dev --experimental-https",
    "dev:https": "cross-env NODE_ENV=development npm-run-all --serial sitecore-tools:generate-map sitecore-tools:build --parallel next:dev:https sitecore-tools:generate-map:watch",
    "test:publication": "node --import tsx --test src/features/publication/*.test.ts",
    "postbuild": "node scripts/check-client-bundle-secrets.mjs",
    "test:health": "node --import tsx --test src/features/health/*.test.ts",
    "test:analytics": "node --import tsx --test src/features/analytics/*.test.ts",
    "test:journey": "node --import tsx --test src/features/insurance/*.test.ts src/features/navigation/route-scroll.test.ts",
    "test:structured-data": "node --import tsx --test src/features/structured-data/*.test.ts",
    "test:search": "node --import tsx --test src/features/search/*.test.ts"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
