# This app is an independent head for the native public SitecoreAI site.
NEXT_PUBLIC_DEFAULT_SITE_NAME=liberty-mutual-public-site
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PERSONALIZE_SCOPE=liberty-mutual-public-site

# Server-side signed Page Builder editing and SDK build metadata use Preview.
SITECORE_EDGE_CONTEXT_ID=
SITECORE_EDITING_SECRET=

# Ordinary pages and APIs use Live in every deployment, including Preview hosts.
SITECORE_LIVE_EDGE_CONTEXT_ID=
# Browser Search, analytics, and personalization use the Live public context.
NEXT_PUBLIC_SITECORE_EDGE_CONTEXT_ID=
PUBLIC_SITE_URL=https://liberty-mutual-public-site.vercel.app

# Private existing Redis integration for publication receipts and authenticated service health.
KV_REST_API_URL=
KV_REST_API_TOKEN=
CRON_SECRET=

# Server-only publication and Search synchronization. See src/features/publication/README.md.
PUBLICATION_WEBHOOK_SECRET=
SITECORE_SEARCH_INGESTION_URL=
SITECORE_SEARCH_SOURCE_ID=
SITECORE_SEARCH_PUSH_API_KEY=
