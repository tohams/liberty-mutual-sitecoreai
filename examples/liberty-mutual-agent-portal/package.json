{
  "name": "liberty-mutual-agent-portal",
  "version": "1.0.0",
  "private": true,
  "config": {
    "appName": "liberty-mutual-agent-portal",
    "graphQLEndpointPath": "/sitecore/api/graph/edge",
    "language": "en",
    "template": "nextjs"
  },
  "author": {
    "name": "Sitecore Corporation",
    "url": "https://doc.sitecore.com/xmc/en/developers/content-sdk/index.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tohams/liberty-mutual-sitecoreai.git"
  },
  "bugs": {
    "url": "https://github.com/tohams/liberty-mutual-sitecoreai/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@sitecore-content-sdk/analytics-core": "^2.1.2",
    "@sitecore-content-sdk/events": "^2.1.2",
    "@sitecore-content-sdk/nextjs": "^2.3.0",
    "@sitecore-content-sdk/personalize": "^2.1.0",
    "@sitecore-marketplace-sdk/client": "0.3.6",
    "@sitecore-marketplace-sdk/xmc": "0.4.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.44.0",
    "next": "^16.3.3",
    "next-intl": "^4.9.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rsc-env": "0.0.2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@sitecore-content-sdk/cli": "^2.2.1",
    "@types/node": "^24.10.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "cross-env": "^10.0.0",
    "eslint": "^9.33.0",
    "eslint-config-next": "^16.3.4",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": ">=8.5.10",
    "picomatch": "4.0.4",
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "brace-expansion@^5.0.0": "5.0.9",
    "lodash-es": "4.18.1",
    "flatted": "3.4.2",
    "esbuild": ">=0.28.1"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "test:setup": "node --test scripts/setup-local.test.mjs",
    "prebuild": "node scripts/check-build-environment.mjs",
    "build": "cross-env NODE_ENV=production npm-run-all --serial sitecore-tools:generate-map sitecore-tools:build next:build",
    "postbuild": "node scripts/check-client-bundle-secrets.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit --incremental false",
    "next:build": "next build",
    "next:dev": "cross-env NODE_OPTIONS='--inspect' next dev",
    "next:start": "next start",
    "sitecore-tools:generate-map": "sitecore-tools project component generate-map",
    "sitecore-tools:generate-map:watch": "sitecore-tools project component generate-map --watch",
    "sitecore-tools:build": "sitecore-tools project build",
    "dev": "cross-env NODE_ENV=development npm-run-all --serial sitecore-tools:generate-map sitecore-tools:build --parallel next:dev sitecore-tools:generate-map:watch",
    "start": "next start",
    "test": "cross-env NODE_OPTIONS=--conditions=react-server node --import tsx --test \"src/**/*.test.ts\"",
    "test:backend": "NODE_OPTIONS='--conditions=react-server' tsx --test src/server/**/*.test.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Liberty Mutual independent-agent portal on SitecoreAI"
}
