# Manual connected-host template for another environment: copy to .env.local and
# supply the appropriate scoped values and secrets. For this private POC's local
# workshop, run npm run setup:local instead; it supplies the approved scoped POC
# contexts and generates independent local secrets before npm ci is needed.

# To secure the Sitecore editor endpoint exposed by your Next.js app
# (`/api/editing/render` by default), a server-only secret token is used.
SITECORE_EDITING_SECRET=

# Your Sitecore site name.
# The value of the variable represents the default/configured site.
NEXT_PUBLIC_DEFAULT_SITE_NAME=liberty-mutual-agent-portal

# Your default app language.
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# Server-only context. Use Live delivery access for production and Preview content
# access for the dedicated editing host. Master Live and Preview IDs are secrets.
SITECORE_EDGE_CONTEXT_ID=
NEXT_PUBLIC_SITECORE_EDGE_PLATFORM_HOSTNAME=https://edge-platform.sitecorecloud.io

# Public-scoped child context with only the browser resources this site requires.
# Never expose a master Live or Preview context in this NEXT_PUBLIC value.
# Configure the separate server value explicitly; the SDK otherwise uses this as its fallback.
NEXT_PUBLIC_SITECORE_EDGE_CONTEXT_ID=

# Public origin of this site (e.g. https://www.example.com). Optional. Used when server code
# builds absolute URLs (metadata, JSON-LD, sitemaps) without a request Host header.
# NEXT_PUBLIC_SITE_URL is preferred; NEXT_PUBLIC_BASE_URL is used if the first is unset.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BASE_URL=

# An optional Sitecore Personalize scope identifier.
# This can be used to isolate personalization data when multiple XM Cloud Environments share a Personalize tenant.
# This should match the PAGES_PERSONALIZE_SCOPE environment variable for your connected XM Cloud Environment.
NEXT_PUBLIC_PERSONALIZE_SCOPE=

# Native decision timeout in positive milliseconds. Portal default: 2000 (SDK default: 400).
# A failed/timed-out decision leaves neutral guidance. Revalidate latency in the destination region.
PERSONALIZE_MIDDLEWARE_CDP_TIMEOUT=

# Campaign discovery timeout in positive milliseconds. Portal default: 1500 (SDK default: 400).
PERSONALIZE_MIDDLEWARE_EDGE_TIMEOUT=

# Opt-in safe stage diagnostics only; no native payloads or identifiers. Keep off outside troubleshooting.
PORTAL_PERSONALIZATION_DIAGNOSTICS=false

# Sitecore Content SDK npm packages utilize the debug module for debug logging.
# https://www.npmjs.com/package/debug
# Keep SDK editing debug logs disabled in shared/deployed environments: upstream logs may include secrets.
# Set the DEBUG environment variable locally only after reviewing the selected namespace:
#DEBUG=content-sdk:*
# Or be selective and show for example only layout service logs:
#DEBUG=content-sdk:layout
# Or everything BUT layout service logs:
#DEBUG=content-sdk:*,-content-sdk:layout

# Client ID and Secret used for Design Library functionality
SITECORE_AUTH_CLIENT_ID=
SITECORE_AUTH_CLIENT_SECRET=

# Portal server configuration. Generate independent secrets; never copy real values into this file.
# Minimum 32 characters each. Keep these out of NEXT_PUBLIC variables and Git.
PORTAL_SESSION_SECRET=
PORTAL_OPERATOR_SECRET=

# Give production and each isolated preview environment different namespaces.
PORTAL_ENVIRONMENT=liberty-mutual-sandbox

# Required durable state provider on Vercel/production. No local fallback is permitted.
PORTAL_REDIS_REST_URL=
PORTAL_REDIS_REST_TOKEN=
# Vercel marketplace aliases KV_REST_API_URL and KV_REST_API_TOKEN are also supported.

# Native CMS metadata is the default. Never set fixtures mode on a deployed site.
PORTAL_CONTENT_ADAPTER=sitecore

# Historical seed generations only: enable after verifying the exact tenant/import receipts.
# New on-demand restart sets activate only from their own verified native import results.
# For the original sandbox seed, see fixtures/udl/import-verification*.json.
PORTAL_VERIFIED_PROFILE_GENERATIONS=
NEXT_PUBLIC_PORTAL_TRACKING_ENABLED=false

# Optional server-only configuration for operator on-demand profile restarts.
# Use the tenant's profile import HTTPS endpoint and API key. Keep the key out of Git,
# NEXT_PUBLIC variables, the browser and the operator CLI; configure it on Vercel.
# Ordinary local workshop/component work does not need either value.
SITECORE_PROFILE_IMPORT_URL=
SITECORE_PROFILE_IMPORT_API_KEY=

# Local development ONLY: use an explicit persistent JSON store if Redis is unavailable.
# PORTAL_STATE_ADAPTER=local-json
# PORTAL_LOCAL_STATE_DIRECTORY=.portal-state
# Isolated component tests may opt into fixture editorial metadata:
# PORTAL_CONTENT_ADAPTER=fixtures
