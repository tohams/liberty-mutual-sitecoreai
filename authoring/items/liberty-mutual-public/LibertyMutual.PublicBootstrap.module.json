      },
      {
        "name": "bootstrap-settings",
        "path": "/sitecore/content/LibertyMutual/liberty-mutual-public-site/Settings",
        "allowedPushOperations": "CreateAndUpdate",
        "scope": "SingleItem"
      },
      {
        "name": "bootstrap-home",
        "path": "/sitecore/content/LibertyMutual/liberty-mutual-public-site/Home",
        "allowedPushOperations": "CreateAndUpdate",
        "scope": "SingleItem"
      }
    ]
  }
}
